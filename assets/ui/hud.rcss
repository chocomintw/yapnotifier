/* Menu-closed overlay. Sizes are dp: the context's dp ratio is the `scale` setting. */
body {
	font-family: Yap;
	width: 100%;
	height: 100%;
}
div { display: block; }
.block { position: absolute; }
.shadow { font-effect: shadow(1dp 1dp #000000be); }
.outline { font-effect: outline(1dp #000000e6); }

/* roster */
#roster { white-space: nowrap; }
#roster.panel { padding: 8dp; }
.title { font-size: 1.15em; }
.icon {
	display: inline-block;
	vertical-align: middle;
	margin-right: 4dp;
}
.name {
	display: inline-block;
	vertical-align: middle;
	overflow: hidden;
	white-space: nowrap;
	margin-right: 4dp;
}
.legacy { color: #ffd94d; }

/* toasts */
.toast {
	position: relative;
	margin-bottom: 6dp;
	padding: 6dp 10dp;
	border-width: 1dp;
	border-radius: 2dp;
}
.toast .bar {
	display: none;
	position: absolute;
	left: 0; top: 0; bottom: 0;
	width: 3dp;
}
#toasts.accent .bar { display: block; }

/* chat */
#chat {
	padding: 6dp;
	border-radius: 4dp;
	font-size: 0.95em;
}
.line { margin-bottom: 2dp; }

/* updater banner */
#notice {
	position: absolute;
	left: 50%;
	top: 24dp;
	transform: translateX(-50%);
	padding: 4dp 10dp;
	border-radius: 4dp;
	background-color: #000000d9;
	color: #ffd94d;
}
