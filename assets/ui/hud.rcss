/* Menu-closed overlay. Sizes are dp: the context's dp ratio is the `scale` setting. */
body {
	font-family: Yap;
	width: 100%;
	height: 100%;
	/* never hit-testable: a click here would focus this document and pull it above the menu */
	pointer-events: none;
}
div { display: block; }
.block { position: absolute; }
/* edit mode (menu open): every block becomes a DESIGN.md feature-card (theme surface, 1dp
   hairline, rounded.lg, 16dp padding, no shadow) with a header row - a timeline pill in the
   primary voltage naming the block and a muted hint - under a hairline. Drag anywhere on it. */
.edit .block {
	pointer-events: auto;
	drag: drag;
	border-width: 1dp;
	border-radius: 12dp;
	padding: 16dp;
	font-effect: none;
	cursor: move;
}
/* ids outrank .edit .block, so the roster's panel and the chat card restate the card metrics */
.edit #roster, .edit #roster.panel { padding: 16dp; }
.edit #chat { padding: 16dp; border-radius: 12dp; }
.grip {
	border-bottom-width: 1dp;
	padding-bottom: 10dp;
	margin-bottom: 12dp;
	white-space: nowrap;
}
.grip .pill {
	display: inline-block;
	vertical-align: middle;
	padding: 4dp 10dp;
	border-radius: 99dp;
	font-size: 11dp;
	font-weight: 600;
	letter-spacing: 0.88dp;
	text-transform: uppercase;
	color: #ffffff;
	background-color: #f54e00;
}
.block:active .grip .pill { background-color: #d04200; }
.grip .hint {
	display: inline-block;
	vertical-align: middle;
	margin-left: 10dp;
	font-size: 12dp;
	font-weight: 400;
}
.shadow { font-effect: shadow(1dp 1dp #000000be); }
.outline { font-effect: outline(1dp #000000e6); }

/* roster */
#roster { white-space: nowrap; }
#roster.panel { padding: 8dp; }
.title { font-size: 1.15em; }
.icon {
	display: inline-block;
	vertical-align: middle;
	margin-right: 4dp;
}
.name {
	display: inline-block;
	vertical-align: middle;
	overflow: hidden;
	white-space: nowrap;
	margin-right: 4dp;
}
.legacy { color: #ffd94d; }

/* toasts: DESIGN.md card (theme surface, 1dp hairline, rounded.md) with the category as a
   timeline-style pill (caption-uppercase). Colours come from the data model; sizes are em so
   the HUD font_size still scales them. No font-effect: shadows/outlines belong on the game, not a card. */
.toast {
	position: relative;
	margin-bottom: 8dp;
	padding: 10dp 12dp;
	border-width: 1dp;
	border-radius: 8dp;
	font-size: 0.9em;
	font-effect: none;
}
.toast .pill {
	display: inline-block;
	vertical-align: middle;
	margin-right: 8dp;
	padding: 2dp 8dp;
	border-radius: 99dp;
	font-size: 0.75em;
	font-weight: 600;
	letter-spacing: 0.88dp;
	text-transform: uppercase;
}
.toast .bar {
	display: none;
	position: absolute;
	left: 0; top: 0; bottom: 0;
	width: 3dp;
	border-radius: 8dp 0 0 8dp;
}
#toasts.accent .bar { display: block; }

/* chat: the same DESIGN.md card as the toasts; the sender prefix is the emphasised part */
#chat {
	padding: 10dp 12dp;
	border-width: 1dp;
	border-radius: 8dp;
	font-size: 0.9em;
	font-effect: none;
}
.line { margin-bottom: 4dp; }
.line:last-child { margin-bottom: 0; }
.line .prefix { font-weight: 600; }

/* updater banner */
#notice {
	position: absolute;
	left: 50%;
	top: 24dp;
	transform: translateX(-50%);
	padding: 4dp 10dp;
	border-radius: 4dp;
	background-color: #000000d9;
	color: #ffd94d;
}
