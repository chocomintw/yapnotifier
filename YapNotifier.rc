// FiveM (asi-five) refuses any .asi on game build 2189+ that does not claim support for the running
// build: it does FindResource(module, L"FX_ASI_BUILD", MAKEINTRESOURCE(GetGameBuild())), so the
// resource NAME is FX_ASI_BUILD and its TYPE is the build number. One line per supported build.
// Servers pin their own build, so claim them broadly: a missing line fails silently (no log, plugin
// never loads), a line for a build that doesn't exist costs nothing. Add a line when the build
// ladder moves. (Same list as blancodagoat/texoverride.)
FX_ASI_BUILD 2189 BEGIN "\0" END
FX_ASI_BUILD 2372 BEGIN "\0" END
FX_ASI_BUILD 2545 BEGIN "\0" END
FX_ASI_BUILD 2612 BEGIN "\0" END
FX_ASI_BUILD 2699 BEGIN "\0" END
FX_ASI_BUILD 2802 BEGIN "\0" END
FX_ASI_BUILD 2944 BEGIN "\0" END
FX_ASI_BUILD 3095 BEGIN "\0" END
FX_ASI_BUILD 3258 BEGIN "\0" END
FX_ASI_BUILD 3323 BEGIN "\0" END
FX_ASI_BUILD 3407 BEGIN "\0" END
FX_ASI_BUILD 3442 BEGIN "\0" END
FX_ASI_BUILD 3570 BEGIN "\0" END
FX_ASI_BUILD 3679 BEGIN "\0" END
FX_ASI_BUILD 3751 BEGIN "\0" END
FX_ASI_BUILD 3775 BEGIN "\0" END
FX_ASI_BUILD 3788 BEGIN "\0" END
FX_ASI_BUILD 3889 BEGIN "\0" END

// UI font (OFL, licence in assets/OFL-Quicksand.txt), embedded so the single-file .asi
// the updater ships stays self-contained. Loaded in overlay.cpp via FindResource.
YAP_FONT RCDATA "assets/Quicksand-Regular.ttf"

// Version resource: an unsigned binary with no version info weighs against it in Defender /
// SmartScreen scoring, and gives a player who right-clicks the file nothing to look at.
// Literal numbers rather than winver.h names so the .rc never needs an include path.
#include "version.h"

1 VERSIONINFO
FILEVERSION    YAP_VERSION_NUM
PRODUCTVERSION YAP_VERSION_NUM
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         0x40004L
FILETYPE       0x2L
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "YapNotifier - TeamSpeak 3 who's-talking overlay for FiveM"
            VALUE "FileVersion",      YAP_VERSION
            VALUE "InternalName",     "YapNotifier"
            VALUE "OriginalFilename", "YapNotifier.asi"
            VALUE "ProductName",      "YapNotifier"
            VALUE "ProductVersion",   YAP_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
